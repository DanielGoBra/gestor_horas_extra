  "components": {
    "schemas": {
      "AprobacionIn": {
        "properties": {
          "observacion": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Observacion"
          }
        },
        "type": "object",
        "title": "AprobacionIn"
      },
      "AprobacionMasivaIn": {
        "properties": {
          "ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Ids"
          }
        },
        "type": "object",
        "required": [
          "ids"
        ],
        "title": "AprobacionMasivaIn"
      },
      "CredencialesIn": {
        "properties": {
          "codigo": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "title": "Codigo",
            "examples": [
              "OP-450"
            ]
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 4,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "codigo",
          "password"
        ],
        "title": "CredencialesIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HorarioIn": {
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date",
            "title": "Fecha"
          },
          "hora_inicio": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Hora Inicio",
            "examples": [
              "18:00"
            ]
          },
          "hora_fin": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Hora Fin",
            "examples": [
              "23:00"
            ]
          }
        },
        "type": "object",
        "required": [
          "fecha",
          "hora_inicio",
          "hora_fin"
        ],
        "title": "HorarioIn"
      },
      "NovedadOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "colaborador_id": {
            "type": "integer",
            "title": "Colaborador Id"
          },
          "colaborador_codigo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Colaborador Codigo"
          },
          "colaborador_nombre": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Colaborador Nombre"
          },
          "area": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
